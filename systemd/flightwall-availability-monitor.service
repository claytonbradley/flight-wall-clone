[Unit]
Description=Recover Flightwall application and network availability
After=flightwall.service network.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/flightwall-availability-monitor
CacheDirectory=flightwall
CacheDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
